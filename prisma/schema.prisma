// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["clientExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  Ordered
  Communication
  DeliveryInProgress
  Delivered
}

enum PaymentStatus {
  pending
  processing
  settled
}

enum UserRole {
  Admin
  Member
  Seller
  Marketer
}

enum SellerStatus {
  approved
  rejected
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  email     String?
  phone     String?
  projects  Project[]
  payments  Payment[]
  seller    Seller?
  promoCodes ProjectPromoCode[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id                    String        @id @default(cuid())
  title                 String
  description           String
  keyFeatures           String[]
  techStack             String[]
  youtubeUrl            String
  demoUrl               String?
  installationGuide     String?
  contactEmail          String?
  contactTwitter        String?
  contactGithub         String?
  category              String
  price                 Float?
  projectType           String
  includesDocumentation Boolean      @default(false)
  includesSourceCode    Boolean      @default(false)
  includesSupport       Boolean      @default(false)
  supportDuration       String?
  lastUpdated           DateTime      @default(now())
  status                ProjectStatus @default(Ordered)
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  payments              Payment[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @default(now()) @updatedAt
  promoCodes            ProjectPromoCode[]
  referrals             Referral[]

  @@map("projects")
}

model Payment {
  id               String        @id @default(cuid())
  amount           Float
  currency         String        @default("INR")
  status           PaymentStatus @default(pending)
  projectStatus    ProjectStatus @default(Ordered)
  project_taken    String?
  razorpayPaymentId String?      @unique
  razorpayOrderId  String?
  razorpaySignature String?
  metadata         Json?
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id])
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  promoCode        ProjectPromoCode?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([projectId])
  @@index([userId])
  @@map("payments")
}

model Seller {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  status    String   @default("rejected")
  verifiedBy String?
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("sellers")
}

model Referral {
  id          String    @id @default(cuid())
  projectId   String
  marketerId  String
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id])
  marketer    Marketer  @relation(fields: [marketerId], references: [id])

  @@map("referrals")
}

model Marketer {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  phone       String
  code        String    @unique
  status      String    @default("pending") // pending, approved, rejected
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  promoCodes  ProjectPromoCode[]
  referrals   Referral[]

  @@index([email])
  @@index([code])
  @@map("marketers")
}

model ProjectPromoCode {
  id          String    @id @default(cuid())
  project     Project   @relation(fields: [projectId], references: [id])
  projectId   String
  marketer    Marketer  @relation(fields: [marketerId], references: [id])
  marketerId  String
  payment     Payment?  @relation(fields: [paymentId], references: [id])
  paymentId   String?   @unique
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([projectId, marketerId, userId])
  @@map("project_promo_codes")
}
