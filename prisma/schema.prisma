generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                    String   @id @default(uuid())
  title                 String
  description           String
  keyFeatures           String[]
  techStack             String[]
  youtubeUrl            String
  demoUrl               String?
  installationGuide     String?
  contactEmail          String?
  contactTwitter        String?
  contactGithub         String?
  category              String
  price                 Float?
  projectType           String   @default("academic")
  includesDocumentation Boolean  @default(false)
  includesSourceCode    Boolean  @default(false)
  includesSupport       Boolean  @default(false)
  supportDuration       String   @default("1")
  lastUpdated           DateTime @default(now())
  userId                String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  @@map("projects")
}
